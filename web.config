<?xml version="1.0" encoding="utf-8"?>
<!-- Caso a sua hospedagem Plesk seja baseada em Windows (utilizando IISNode) -->
<configuration>
  <system.webServer>
    <handlers>
      <!-- Define o app.js como o arquivo executável a ser rodado no Node.js -->
      <add name="iisnode" path="app.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^app.js\/debug[\/]?" />
        </rule>
        <!-- Regra principal: intercepta requisições de páginas e envia ao Node -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="app.js" />
        </rule>
      </rules>
    </rewrite>
    <iisnode nodeProcessCommandLine="node.exe" />
  </system.webServer>
</configuration>
